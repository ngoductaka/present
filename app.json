{
  "expo": {
    "name": "present",
    "slug": "present",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/private-diary-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/private-diary-splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f9eee3"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.notificationscheduler.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "NSCameraUsageDescription": "Present uses the camera so you can take photos and attach them to your diary entries.",
        "NSPhotoLibraryUsageDescription": "Present uses your photo library so you can choose images to attach to your diary entries.",
        "NSPhotoLibraryAddUsageDescription": "Present saves selected diary images in the app so they remain available with your entries."
      }
    },
    "android": {
      "package": "com.notificationscheduler.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/private-diary-adaptive-icon.png",
        "backgroundColor": "#f9eee3"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/private-diary-favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker"
    ]
  }
}
